# This project has two apps, each with its own env configuration:
#
#   backend/AssignmentSystem.Api/appsettings.json           -- safe placeholder values, committed
#   backend/AssignmentSystem.Api/appsettings.Development.json -- your real local secrets, gitignored
#   frontend/.env.example                                    -- copy to frontend/.env.local
#
# The variables below are what you need to set for local development. ASP.NET
# Core reads configuration from appsettings.*.json by default, but every key
# can also be overridden by an environment variable using "__" (double
# underscore) instead of ":" for nesting -- e.g. ConnectionStrings__DefaultConnection.
# That's how you'd supply real secrets in a deployed environment (Docker,
# CI, a hosting provider) instead of committing them to appsettings.*.json.

# ---- Backend (ASP.NET Core) ----
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=assignment_app;Password=CHANGE_ME
Jwt__Key=CHANGE_ME_MIN_32_CHARS_LONG_SECRET_KEY
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystemClient
Jwt__ExpiryHours=4

# ---- Frontend (Next.js) ----
# See frontend/.env.example -- copy it to frontend/.env.local and set:
BACKEND_URL=http://localhost:5096
